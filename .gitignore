# emacs

*.elc
*.eln
*~
#*#

auto-save-list
history
recentf
session.*

# python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
.ipynb_checkpoints/

# generated specialized algebras -- produced by tools/gen_specialized.py
# (make generate / make shell / the setup.py build hook). Not tracked; baked
# into the sdist + wheel at build time so a pip install is still readable.
# The g[0-9]* glob covers every dimension (g1..g3 by default, g4/g5 release-only,
# any future gN) while NOT matching the tracked, hand-written gn.py ('n' ∉ [0-9]).
/src/gacalc/g[0-9]*.py

# exported OCI image tars (make image-export) — large, never commit
gacalc-*.tar

# sphinx book (make docs): the build tree is regenerated, and output/ holds the
# copied-out HTML/PDF. Neither is tracked; keep the output/ dir itself via .gitkeep.
/book/docs/_build/
/output/*
!/output/.gitkeep
# book notebooks: the percent-format .py sources are tracked; the .ipynb are
# generated from them at build time (docs.sh / jupytext), so ignore those.
/book/docs/notebooks/*.ipynb
